# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Web Push (VAPID) — generate with `npm run vapid:generate` ─────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@skillforge.app

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key

# ── Resend (transactional email) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=SkillForge <notifications@yourdomain.com>

# ── Cron security ───────────────────────────────────────────────────────────
CRON_SECRET=generate-a-long-random-string

# ── Supabase Edge Functions (set via `supabase secrets set`) ───────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
